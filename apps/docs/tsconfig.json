{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "jsx": "preserve",
    "plugins": [{ "name": "next" }],
    "paths": {
      "@/*": ["./*"],
      "@lorenthi/ui": ["../../packages/ui/src/index.ts"],
      "@lorenthi/ui/motion": ["../../packages/ui/src/motion/index.ts"],
      "@lorenthi/ui/*": ["../../packages/ui/src/components/*"]
    },
    "incremental": true
  },
  "include": ["next-env.d.ts", "**/*.ts", "**/*.tsx", ".next/types/**/*.ts"],
  "exclude": ["node_modules"]
}
