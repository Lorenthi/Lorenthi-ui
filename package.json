{
  "name": "lorenthi-ui-monorepo",
  "private": true,
  "version": "0.1.0",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "dev": "npm run registry && npm run dev -w @lorenthi/docs",
    "build": "npm run registry && npm run build -w @lorenthi/docs",
    "registry": "node scripts/build-registry.mjs",
    "typecheck": "tsc -p packages/ui/tsconfig.json --noEmit",
    "cli": "node packages/cli/bin/lorenthi-ui.mjs",
    "test:ui": "node scripts/ui-test.mjs --build"
  },
  "devDependencies": {
    "puppeteer-core": "^24.43.1",
    "typescript": "^5.7.0"
  },
  "engines": {
    "node": ">=20"
  }
}
